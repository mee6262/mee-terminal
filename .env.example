# คัดลอกเป็น web_terminal/.env บน VPS (ห้าม commit .env)
# WT_PASS_HASH ได้จาก: venv\Scripts\python.exe hash_password.py
WT_PASS_HASH=scrypt$32768$8$1$...$...
WT_ORIGIN=https://terminal.example.com
# key ร่วม gateway<->worker (สุ่มยาว ≥16): venv\Scripts\python.exe -c "import secrets;print(secrets.token_urlsafe(32))"
WT_WORKER_KEY=
